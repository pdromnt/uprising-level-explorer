{
  "name": "uprising-level-viewer",
  "productName": "Uprising Level Explorer",
  "version": "0.1.0",
  "description": "A read-only level explorer for Uprising: Join or Die",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "package": "npm run build && node scripts/package.mjs",
    "test:desktop": "node scripts/smoke-electron.mjs",
    "package:folder": "npm run build && electron-packager . \"Uprising Level Explorer\" --icon=public/app-icon.ico --out=releases --overwrite --ignore=^/public --ignore=^/src --ignore=^/tests --ignore=^/tools --ignore=^/docs --ignore=^/releases --ignore=^/scripts --ignore=^/node_modules --ignore=^/artifacts --asar",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "three": "0.186.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pdromnt/uprising-level-explorer.git"
  },
  "author": "pdromnt"
}
